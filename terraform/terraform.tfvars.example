# Terraform Variables - Copy to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control

# Alibaba Cloud Credentials
# region          = "cn-hangzhou"  # Default region
# access_key      = "your_access_key_id_here"
# secret_key      = "your_access_key_secret_here"

# Project Configuration
project_name = "estate-manager"

# VPC Configuration
vpc_cidr = "172.16.0.0/16"

# Database Configuration
# db_password = "your_secure_db_password_min_8_chars"  # Must be set in tfvars file

# ACK Kubernetes Cluster (Optional)
enable_ack = false  # Set to true to deploy ACK cluster

# Optional: Instance Types and Sizing
# worker_instance_type = "ecs.c6.large"
# rds_instance_type = "mysql.n2.medium.2c"
# rds_storage_gb = 20
