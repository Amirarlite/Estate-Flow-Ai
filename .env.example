# .env.example - DO NOT COMMIT ACTUAL VALUES TO GIT
# Copy this file to .env.local for local development
# For production, use Alibaba Cloud environment variables

# Application Settings
NODE_ENV=development
PORT=8080
APP_NAME="Estate Manager"

# Database Configuration (Alibaba Cloud RDS MySQL)
DATABASE_URL=mysql://user:password@rm-xxxxx.mysql.rds.aliyuncs.com:3306/estate_db
DB_HOST=rm-xxxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=estate_db
DB_USER=estate_user
DB_PASSWORD=your_secure_password

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRATION=7d

# Alibaba Cloud OSS (Object Storage Service)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=estate-manager-assets
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your_smtp_password

# Push Notifications (Expo Push)
EXPO_PUSH_TOKEN=your_expo_push_token

# Monitoring & Logging
LOG_LEVEL=debug
ENABLE_SENTRY=false
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,https://app.estatemanager.com

# Session Configuration
SESSION_SECRET=your_session_secret_here
