# .env.example - DO NOT COMMIT ACTUAL VALUES TO GIT
# Copy this file to .env.local for local development
# For production, use AWS environment variables via Amplify Secret Manager

# Application Settings
NODE_ENV=development
PORT=8080
APP_NAME="Estate Manager"

# Database Configuration (AWS RDS MySQL)
DATABASE_URL=mysql://<username>:<password>@<rds-endpoint>:3306/<dbname>
DB_HOST=<rds-endpoint>
DB_PORT=3306
DB_NAME=<dbname>
DB_USER=<username>
DB_PASSWORD=<password>

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRATION=7d

# AWS S3 Configuration (if needed for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET=estate-manager-assets

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your_smtp_password

# Push Notifications (Expo Push)
EXPO_PUSH_TOKEN=your_expo_push_token

# Monitoring & Logging
LOG_LEVEL=debug
ENABLE_SENTRY=false
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,https://app.estatemanager.com

# Session Configuration
SESSION_SECRET=your_session_secret_here